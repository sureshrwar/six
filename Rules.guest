#
# Rules.guest -- how to build the guest userland.
#
# The guest userland (library/ = the emulated machine's mini-libc,
# applications/ = init, getty, login, sh, ls, ...) targets the *emulated*
# machine, not the host.  It does not share CFLAGS with the kernel, and it
# must not simply pick up the host toolchain's idea of what a C program is.
#
# Every guest Makefile includes this file rather than spelling out its own
# flags, which is how the 2005 tree did it and is why no two of them agreed.
#
# Include it as:
#       SIXTOP := $(shell cd $(dir $(lastword $(MAKEFILE_LIST)))../.. && pwd)
#       include $(SIXTOP)/Rules.guest
#

# ---------------------------------------------------------------------------
# Where the source root is.
#
# Worked out from the location of this file, so that it does not matter how
# deep the including Makefile is or what directory make was invoked from.
# ---------------------------------------------------------------------------
SIX_GUEST_TOP := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

GUEST_CC = gcc
GUEST_LD = ld
GUEST_AR = ar

# ---------------------------------------------------------------------------
# Include path
#
# -nostdinc, because the guest is not a host program and must not see
# glibc's headers.  In 2005 the build had no -nostdinc and no consistent
# include path, so it half-picked-up Solaris system headers; on Linux the
# same arrangement half-picks-up glibc's, and the result was 47 of 206 files
# failing to compile with errors like "unknown type name 'size_t'" and
# "redefinition of 'struct stat'".
#
# Three directories, in this order:
#
#   1. GCC's own headers.  -nostdinc removes these too, and we want them
#      back: stdarg.h, stddef.h and friends are properties of the compiler,
#      not of the C library, and va_list cannot be written without them.
#      -isystem rather than -I so they are searched last and can be
#      overridden.
#   2. library/include -- the guest's own libc headers.
#   3. include -- the kernel tree, for the linux/*.h ABI headers: errno
#      numbers, ioctl numbers, termios, fcntl, the syscall-visible structs.
#      This is not a layering violation; it is what /usr/include/linux was
#      on a real Linux 2.0 system, where those headers were symlinks into
#      the kernel source.
#
# Note what is *not* here: -D__KERNEL__.  library/sys/Makefile used to pass
# it, which is wrong for a user program -- among other things it changes
# which typedefs include/linux/types.h makes visible -- and it is why those
# files could get away with including <linux/sched.h>.  They include
# <sched.h> now (library/include/sched.h).
# ---------------------------------------------------------------------------
GUEST_GCCINC := $(shell $(GUEST_CC) -m32 -print-file-name=include)

GUEST_INCLUDES = -nostdinc \
		 -isystem $(GUEST_GCCINC) \
		 -I$(SIX_GUEST_TOP)/library/include \
		 -I$(SIX_GUEST_TOP)/include

# ---------------------------------------------------------------------------
# Compiler flags
#
# -m32                  the emulated machine is 32-bit x86.  Everything in
#                       this tree assumes sizeof(long) == sizeof(void *) == 4.
# -fno-pic -fno-pie     the guest is loaded at a fixed address by SIX's own
#                       ELF loader, which does not relocate.  It also lets
#                       the "b" (%ebx) asm constraint in library/sys work;
#                       under PIC, %ebx is the GOT pointer and GCC refuses.
# -fno-builtin          there is no host libc to call.  Without this, GCC
#                       turns printf("x\n") into puts("x") and small memcpys
#                       into inline code that may reference symbols the
#                       guest libc does not have.
# -fno-stack-protector  the guest has no __stack_chk_fail and no TLS.
# -std=gnu89 -fcommon   this is 1990s C; see the kernel's SIX_STDFLAGS for
#                       the same reasoning.
# -O0                   keep the generated code close to the source while
#                       the port is being debugged.
# ---------------------------------------------------------------------------
GUEST_CFLAGS = -m32 $(GUEST_INCLUDES) \
	       -fno-pic -fno-pie -fno-builtin -fno-stack-protector \
	       -std=gnu89 -fcommon -fno-strict-aliasing \
	       -g -O0 -w -DSIX=1

# ---------------------------------------------------------------------------
# Link
#
# SIX_BIND_POINT is where guest programs live in the emulated address space.
# It has to agree with include/solaris.h, and with the big diagram in
# fs/binfmt_elf.c that describes the layout.
#
# The x86 mapfile used to say 0x1000, alone among the two architectures --
# applications/map/sparc/user.map has always said 0x3000000.  0x1000 cannot
# work on Linux: vm.mmap_min_addr is 65536, so the loader's MAP_FIXED of the
# first segment returns EPERM and the exec fails before the program starts.
# Changing the host sysctl would have fixed it too, but that is a real
# exploit mitigation and this is a hobby kernel; relinking is free and makes
# the two architectures agree.
#
# 48 MB is clear of everything else in the host address space: SIX's own
# text starts at 0x08048000, its heap runs to about 167 MB, the emulated
# RAM is mapped around 185-209 MB, and the host libc sits up at 0xf7d1a000.
#
# The Solaris mapfiles (-M applications/map/*/user.map) are not used on
# Linux.  GNU ld cannot read them; -Ttext expresses the only thing they
# said that mattered.
# ---------------------------------------------------------------------------
SIX_BIND_POINT = 0x3000000

# The segment layout matters as much as the address.
#
# A modern GNU ld, left alone, emits five program headers and four LOAD
# segments: a read-only one holding just the ELF headers, a read+execute
# one for .text, another read-only one for .rodata, and a read-write one
# for .data and .bss.  That is a sensible arrangement for a system with
# per-segment page protections and a dynamic loader.  It is not what
# fs/binfmt_elf.c was written against in 1996, and it is not what the
# Solaris mapfile produced: "text = LOAD ?RX" and "data = LOAD ?RWX" is
# two segments, and the first one starts with the ELF header.
#
#   -z noseparate-code   put .rodata back in the text segment, so there
#                        are two LOAD segments rather than four.
#   -Ttext-segment       set the address of the *segment*, not of the
#                        .text section.  With plain -Ttext the linker puts
#                        .text at the bind point and the ELF headers in a
#                        segment one page below it, at 0x2fff000, which is
#                        both surprising and outside the region the rest
#                        of the system reasons about.
#
# The result is what the 2005 binaries looked like:
#
#   LOAD 0x03000000 R E   .text .rodata
#   LOAD 0x03003000 RW    .data .bss
#
# GNU_STACK is still emitted and is harmless -- the loader's segment loop
# only looks at PT_LOAD -- but -z noexecstack keeps it honest.
GUEST_LDFLAGS = -m elf_i386 -static --build-id=none -z noexecstack \
		-z noseparate-code \
		-Ttext-segment $(SIX_BIND_POINT) -e cstart

GUEST_LIBC     = $(SIX_GUEST_TOP)/library/libc/lib/libc.a
GUEST_LIBCURSES= $(SIX_GUEST_TOP)/library/curses/lib/libcurses.a
GUEST_CRT      = $(SIX_GUEST_TOP)/applications/start/cstart.o

# The standard recipe for a guest program: $(call guest_link,name,objects)
guest_link = $(GUEST_LD) $(GUEST_LDFLAGS) -o $(1) $(GUEST_CRT) $(2) $(GUEST_LIBC)
guest_link_curses = $(GUEST_LD) $(GUEST_LDFLAGS) -o $(1) $(GUEST_CRT) $(2) $(GUEST_LIBCURSES) $(GUEST_LIBC)

%.o: %.c
	$(GUEST_CC) $(GUEST_CFLAGS) -MMD -MF $(dir $@).$(notdir $@).d -c -o $@ $<

#
# Assembly.  Capital .S so the preprocessor runs -- setjmp_i386.S uses
# #define for its jmp_buf offsets, and having them symbolic is worth the
# extra pass.
#
# This is the first assembly in the tree that is actually compiled: the SIX
# kernel has none at all (every trap, context switch and "instruction" is a
# libc call), and the SPARC guest's setjmp.s was only ever built by the
# Solaris Makefiles.  Same flags as C so that -m32 and the include path
# carry over.
#
%.o: %.S
	$(GUEST_CC) $(GUEST_CFLAGS) -MMD -MF $(dir $@).$(notdir $@).d -c -o $@ $<

# ---------------------------------------------------------------------------
# Header dependencies
#
# -MMD above drops a .foo.o.d beside every object listing the headers it
# actually read.  Pull them in so that editing library/include/stdio.h
# rebuilds the 80 files that include it, rather than leaving a tree of
# objects that were compiled against a struct layout that no longer exists.
# The kernel build has done this since the -MMD change; the guest build had
# no dependency tracking at all, which is a quiet way to spend an afternoon
# debugging a binary that does not contain your fix.
#
# Only this directory's .d files, and deliberately so.  They name their
# targets and prerequisites relative to the directory they were generated
# in ("access.o: access.c ..."), so including library/sys's set from
# library/libc -- which builds ../sys/*.o as prerequisites of libc.a --
# makes make look for a library/libc/access.c that does not exist.
# library/Makefile always builds sys before libc, so sys's own include is
# where those dependencies belong.
# ---------------------------------------------------------------------------
-include $(wildcard .*.o.d)

#
# Undo the side effect of that include.
#
# A .d file is a Makefile fragment full of explicit targets ("io.o: io.c
# sh.h ..."), and GNU make takes the first explicit target it parses as the
# default goal.  Because this file is included at the *top* of every guest
# Makefile, the first target make saw was whichever .o happened to sort
# first -- so "make -C applications/sh" quietly built interp.o and stopped,
# and "make -C library/libc" never reached libc.a.  The symptom is
# particularly nasty because make exits 0.
#
# Assigning an empty value tells make to fall back to "the first target
# defined from here on", which is the one the including Makefile actually
# wanted.
#
.DEFAULT_GOAL :=
