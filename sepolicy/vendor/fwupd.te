# sepolicy/vendor/fwupd.te
# Vendor Firmware Update Daemon (/vendor/bin/fwupd) SELinux Policy
# Mirrors device/google/desktop/common/sepolicy/fwupd.te (b/467820671, ag/41886338, ag/42147366)
@tier vendor

# ==============================================================================
# Type Declarations
# ==============================================================================
# Note: fwupd domain, fwupd_exec, and init_daemon_domain(fwupd) are declared in system/sepolicy

typeattribute fwupd vendordomain, mlstrustedsubject;

# Script domain and executable
type fwupd_script, domain, vendordomain;
type fwupd_script_exec, exec_type, file_type, vendor_file_type;

# CLI tool executable
type fwupdmgr_exec, exec_type, file_type, vendor_file_type;

# Data files
type fwupd_data_file, file_type, data_file_type, vendor_file_type;

# ==============================================================================
# Init & Service Setup
# ==============================================================================

init_daemon_domain(fwupd_script)

# Register service
add_service(fwupd, fwupd_service)

# ==============================================================================
# FWUPD Daemon Policy (u:r:fwupd:s0)
# ==============================================================================

# --- IPC & Binder ---
binder_use(fwupd)
binder_call(shell, fwupd)

# Allow receiving binder calls/files from the script
allow fwupd fwupd_script:binder { call transfer };
allow fwupd fwupd_script:fd use;

# --- Fwupd Shell ---
allow shell fwupdmgr_exec:file { getattr open read execute execute_no_trans rx_file_perms };

# --- Filesystem Access ---
allow fwupd fwupd_data_file:dir { create_dir_perms add_name remove_name };
allow fwupd fwupd_data_file:file create_file_perms;
allow fwupd vendor_data_file:dir create_dir_perms;
allow fwupd vendor_data_file:file create_file_perms;
allow fwupd vendor_data_file:lnk_file create_file_perms;
allow fwupd selinuxfs:file r_file_perms;

# --- Hardware & Kernel Access ---
allow fwupd self:netlink_kobject_uevent_socket { create bind read setopt getattr };

# Allow NVMe/UFS firmware updates (only sys_admin and sys_rawio; NO dac_override)
allow fwupd self:capability { sys_admin sys_rawio };

# Hardware devices (USB)
allow fwupd usb_device:dir r_dir_perms;
allow fwupd usb_device:chr_file rw_file_perms;

# Kernel logs (restricted to write only per ag/41847641 & ag/41886338) and process info
allow fwupd kmsg_device:chr_file write;
allow fwupd proc_cmdline:file r_file_perms;
allow fwupd proc_stat:file r_file_perms;
allow fwupd proc_diskstats:file r_file_perms;

# --- Sysfs Attributes ---
allow fwupd sysfs:dir r_dir_perms;
allow fwupd sysfs:file rw_file_perms;
allow fwupd sysfs_devices_block:dir r_dir_perms;
allow fwupd sysfs_devices_block:file r_file_perms;
allow fwupd { sysfs_ufs sysfs_nvme }:dir r_dir_perms;
allow fwupd { sysfs_ufs sysfs_nvme }:file r_file_perms;

# --- Access to NVMe devices ---
allow fwupd block_device:dir search;
allow fwupd nvme_block_device:chr_file rw_file_perms;
allow fwupd nvme_block_device:blk_file rw_file_perms;
allow fwupd nvme_device:chr_file rw_file_perms;
allow fwupd nvme_device:blk_file rw_file_perms;
allowxperm fwupd nvme_block_device:blk_file ioctl 0x4E41;
allowxperm fwupd nvme_device:chr_file ioctl 0x4E41;
allowxperm fwupd nvme_device:blk_file ioctl 0x4E41;

# --- Access to sdX / UFS devices ---
allow fwupd sdx_block_device:blk_file rw_file_perms;
allowxperm fwupd sdx_block_device:blk_file ioctl { 0x2285 0x1272 };
allow fwupd { ufs_dev ufs_rpmb_device }:chr_file rw_file_perms;
allow fwupd vold_device:blk_file rw_file_perms;
allowxperm fwupd ufs_dev:chr_file ioctl { 0x2285 0x5540-0x5543 };
allowxperm fwupd vold_device:blk_file ioctl { 0x2285 0x5382-0x5386 };

# ==============================================================================
# FWUPD Script Policy (u:r:fwupd_script:s0)
# ==============================================================================
allow fwupd_script fwupdmgr_exec:file { rx_file_perms entrypoint };
binder_use(fwupd_script)
binder_call(fwupd_script, servicemanager)
binder_call(fwupd_script, fwupd)
allow fwupd_script fwupd_service:service_manager find;
allow fwupd_script fwupd_data_file:dir { create_dir_perms write remove_name search };
allow fwupd_script fwupd_data_file:file { create_file_perms unlink r_file_perms };
allow fwupd_script vendor_file:file { read getattr map execute execute_no_trans };
