# sepolicy/vendor/file_contexts
# Vendor file_contexts (installed to /vendor/etc/selinux/vendor_file_contexts)

/vendor(/.*)?               u:object_r:vendor_file:s0
/vendor/etc(/.*)?           u:object_r:vendor_configs_file:s0
/vendor/etc/selinux(/.*)?   u:object_r:vendor_configs_file:s0
/vendor/bin/fwupd           u:object_r:fwupd_exec:s0
/vendor/bin/fwupdmgr        u:object_r:vendor_file:s0
/data/vendor(/.*)?          u:object_r:vendor_data_file:s0
/etc/fwupd(/.*)?            u:object_r:vendor_data_file:s0
/var/lib/fwupd(/.*)?        u:object_r:vendor_data_file:s0

# Vendor storage & firmware update device nodes
/dev/ufsa                   u:object_r:sdx_block_device:s0
/dev/ufs-bsg0               u:object_r:ufs_dev:s0
/dev/ufs-rpmb0              u:object_r:ufs_rpmb_device:s0
/dev/nvme0                  u:object_r:nvme_device:s0
/dev/nvme0n1                u:object_r:nvme_device:s0
