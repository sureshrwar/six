# system/sepolicy/private/file_contexts
# Core system file_contexts mapping (installed to /system/etc/selinux/plat_file_contexts)

/                           u:object_r:rootfs:s0
/bin(/.*)?                  u:object_r:system_file:s0
/bin-sarthak(/.*)?          u:object_r:system_file:s0
/system(/.*)?               u:object_r:system_file:s0
/etc(/.*)?                  u:object_r:system_file:s0
/etc/shadow                 u:object_r:shadow_file:s0
/etc/selinux(/.*)?          u:object_r:sepolicy_file:s0
/system/etc/selinux(/.*)?   u:object_r:sepolicy_file:s0

# Core system daemon entrypoints
/bin/init                   u:object_r:init_exec:s0
/bin/servicemanager         u:object_r:servicemanager_exec:s0
/bin/vold                   u:object_r:vold_exec:s0
/bin/storaged               u:object_r:storaged_exec:s0
/bin/mediaproviderd         u:object_r:mediaprovider_exec:s0
/bin/externalstoraged       u:object_r:externalstoraged_exec:s0
/bin/adbd                   u:object_r:adbd_exec:s0
/bin/httpd                  u:object_r:httpd_exec:s0
/bin/telnetd                u:object_r:telnetd_exec:s0
/bin/sh                     u:object_r:shell_exec:s0
/bin/su                     u:object_r:su_exec:s0

# NTFS FUSE driver binaries in /system/bin (/bin) (ag/41792131, ag/41271392)
/bin/ntfs-3g                u:object_r:ntfs_3g_exec:s0
/bin/ntfsfix                u:object_r:ntfs_3g_exec:s0
/bin/mkntfs                 u:object_r:ntfs_3g_exec:s0
/system/bin/ntfs-3g         u:object_r:ntfs_3g_exec:s0
/system/bin/ntfsfix         u:object_r:ntfs_3g_exec:s0
/system/bin/mkntfs          u:object_r:ntfs_3g_exec:s0

# Filesystem check & format helpers
/bin/fsck\.fat              u:object_r:fsck_exec:s0
/bin/mkdosfs                u:object_r:fsck_exec:s0

# Core device nodes
/dev/null                   u:object_r:null_device:s0
/dev/zero                   u:object_r:zero_device:s0
/dev/random                 u:object_r:random_device:s0
/dev/urandom                u:object_r:random_device:s0
/dev/kmsg                   u:object_r:kmsg_device:s0
/dev/mem                    u:object_r:kmem_device:s0
/dev/kmem                   u:object_r:kmem_device:s0
/dev/console                u:object_r:console_device:s0
/dev/tty.*                  u:object_r:tty_device:s0
/dev/binder                 u:object_r:binder_device:s0
/dev/fuse                   u:object_r:fuse_device:s0
/dev/adb                    u:object_r:adb_device:s0
/dev/power                  u:object_r:power_device:s0
/dev/hda                    u:object_r:root_block_device:s0
/dev/hdb                    u:object_r:swap_block_device:s0
/dev/hdc                    u:object_r:vold_device:s0
/dev/hdd                    u:object_r:vold_device:s0
/dev/sd.*                   u:object_r:vold_device:s0

# Virtual filesystems & data partitions
/sys/fs/selinux(/.*)?       u:object_r:selinuxfs:s0
/sys/fs/pstore(/.*)?        u:object_r:pstorefs:s0
/sys/power/wake_lock        u:object_r:sysfs_wake_lock:s0
/sys/power/wake_unlock      u:object_r:sysfs_wake_lock:s0
/sys/power(/.*)?            u:object_r:sysfs_power:s0
/data(/.*)?                 u:object_r:system_data_file:s0
/data/media(/.*)?           u:object_r:media_rw_data_file:s0
/data/app(/.*)?             u:object_r:app_data_file:s0
/mnt                        u:object_r:mnt_media_rw_stub_file:s0
/mnt/media_rw(/.*)?         u:object_r:mnt_media_rw_file:s0
/mnt/expand(/.*)?           u:object_r:mnt_media_rw_file:s0
/storage(/.*)?              u:object_r:media_rw_data_file:s0
/sdcard(/.*)?               u:object_r:media_rw_data_file:s0
/tmp(/.*)?                  u:object_r:tmpfs:s0
/home(/.*)?                 u:object_r:user_home_file:s0
/var/mail(/.*)?             u:object_r:user_home_file:s0
/usr/adm(/.*)?              u:object_r:system_data_file:s0
/etc/utmp                   u:object_r:system_data_file:s0
/\.bash_history             u:object_r:user_home_file:s0
