# Build products
*.o
*.a
/six
/sadb
System.map
vmlinux
.depend
.hdepend
.tmpdepend
.version
.ver
include/linux/compile.h

# include/asm is a generated symlink (make symlinks -> asm-six)
/include/asm

# Editor / misc
*~
*.orig
*.rej
*.swp
.*.swp
core

# Port scratch area (build logs etc). Disk images are NOT ignored:
# disk/x86/root and disk/sparc/root are checked in on purpose.
/port/log/

# gcc -MMD header dependency files (see Rules.make)
.*.o.d

# Generated root filesystem images -- built by port/image/mkimage.sh
# (the pristine 2005 images live forever in tag v2005-cvs)
disk/x86/root
disk/sparc/root
disk/*/root
disk/*/bin_storage
include/linux/verity_roothash.h
port/image/.stage_bin/

# The optional auxiliary disk (/dev/hdb), built by port/image/mkaux.sh.
# Never checked in: it is not reconstructible from the tree, and having it
# absent is the default state the kernel is expected to cope with.
disk/*/aux_storage-*
disk/*/usb_*.img

# Guest userland binaries.  These were checked in as 2005 SPARC big-endian
# ELF executables, which are useless on x86 and were silently being copied
# into the disk image.  They are build products; port/image/mkimage.sh
# rebuilds them.  The originals remain in tag v2005-cvs.
applications/*/banner
applications/*/cat
applications/*/clear
