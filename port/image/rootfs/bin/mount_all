#!/bin/sh
# /bin/mount_all - mount filesystems defined in /etc/fstab

primary_fs=`ext4info -t /dev/hda`
case "$primary_fs" in
ext4|ext2)
	echo "Mounting primary storage: $primary_fs filesystem detected"
	;;
*)
	echo "Mounting primary storage: $primary_fs"
	;;
esac

secondary_fs=`ext4info -t /dev/hdb`
case "$secondary_fs" in
none)
	echo "Mounting secondary storage: not detected"
	;;
NTFS|ext4|ext2)
	echo "Mounting secondary storage: $secondary_fs filesystem detected"
	;;
*)
	echo "Mounting secondary storage: unknown filesystem"
	;;
esac

# Mount all auto entries from /etc/fstab (/proc, /tmp, /dev/nvme0n1 -> /data, /dev/hdb -> /aux/storage-1)
mount -a

# Android init post-fs-data directory initialization on /data (/dev/nvme0n1)
mkdir /data/vendor 2>/dev/null
mkdir /data/vendor/fwupd 2>/dev/null
mkdir /data/misc 2>/dev/null
mkdir /data/misc/vold 2>/dev/null
mkdir /data/media 2>/dev/null
mkdir /data/media/0 2>/dev/null
restorecon -R /data/vendor /data/media /data/misc >/dev/null 2>&1
