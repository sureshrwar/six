#!/bin/sh
# /bin/mount_all - mount filesystems defined in /etc/fstab

primary_fs=`ext4info -t /dev/hda`
case "$primary_fs" in
ext4|ext2)
	echo "Mounting primary storage: $primary_fs filesystem detected"
	;;
*)
	echo "Mounting primary storage: $primary_fs"
	;;
esac

secondary_fs=`ext4info -t /dev/hdb`
case "$secondary_fs" in
none)
	echo "Mounting secondary storage: not detected"
	;;
NTFS|ext4|ext2)
	echo "Mounting secondary storage: $secondary_fs filesystem detected"
	;;
*)
	echo "Mounting secondary storage: unknown filesystem"
	;;
esac

# Mount all auto entries from /etc/fstab (/proc, /tmp, /dev/hdb -> /aux/storage-1)
mount -a
